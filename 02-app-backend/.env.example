# ============================================================================
# CovA Backend Environment Variables
# ============================================================================
# Copy this file to .env and fill in the values.
# NEVER commit .env to version control.
# ============================================================================

# --- DATABASE (REQUIRED) ---
# PostgreSQL connection string. Neon format:
# postgresql://user:password@host.neon.tech/cova_db?sslmode=require
DATABASE_URL=postgresql://user:password@your-neon-host.neon.tech/cova_db?sslmode=require

# Optional: Read replica for dashboard/report queries (falls back to primary)
# DATABASE_URL_READ=postgresql://user:password@your-replica.neon.tech/cova_db?sslmode=require

# --- MODE ---
# 'real' = production 5-year data | 'demo' = high-speed simulation data
COVA_MODE=demo

# --- SERVER ---
PORT=3001

# --- EXTERNAL APIs ---
# Groq AI for claim explanations (get key from console.groq.com)
GROQ_API_KEY=gsk_your_key_here

# Razorpay for UPI payouts (test keys from dashboard.razorpay.com)
RAZORPAY_KEY_ID=rzp_test_your_key
RAZORPAY_KEY_SECRET=your_secret

# --- OPTIONAL ---
# Redis for production caching (falls back to in-memory Map)
# REDIS_URL=redis://default:password@your-redis.upstash.io:6379
